# Exclude source, dev tooling, and build artifacts — keep node_modules for solc
.vscode/**
src/**
runner/**
examples/**
docs/**
scripts/**
releases/**

# TypeScript / build config
tsconfig.json
webpack.config.js
jest.config.js
commitlint.config.js
.eslintrc*
eslint.config.js
.prettierrc*
.editorconfig

# Dev files (vsce matches with minimatch — `*` does not cross `/`, so use `**/`)
*.ts
**/*.ts
**/*.map
tsconfig.webview.json
.husky/**
.gitignore
.git/**
CLAUDE.md
CONTRIBUTING.md

# Test files
**/__tests__/**
**/*.test.*
**/*.spec.*

# node_modules never ships: `vsce package --no-dependencies` excludes it, and all
# runtime deps are webpack-bundled into dist/. The `solc` package (9 MB soljson)
# is intentionally absent — SolcManager downloads compilers on demand instead.
node_modules/**

# Platform-specific runner binary (postinstall artifact) — never ship it in the
# universal vsix; the extension falls back to forge/solc when it is absent.
bin/**

# Landing-page website and brand master files live in the repo but never ship
# inside the extension
website/**
brand/**
skills/**
*.vsix

# Dev configs that add nothing at runtime
.prettierignore
.versionrc.json

# CLI bundle never ships in the vsix: the shipped manifest has no `bin`, the
# extension runtime never spawns it, and its second copy of ethers/ajv is
# exactly the kind of surface marketplace malware scanners flag.
dist/cli/**
