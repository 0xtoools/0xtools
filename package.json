    "languageModelTools": [
      {
        "name": "0xtools_audit_solidity",
        "displayName": "0xTools: Audit Solidity",
        "toolReferenceName": "auditSolidity",
        "canBeReferencedInPrompt": true,
        "icon": "$(shield)",
        "tags": [
          "solidity",
          "security",
          "0xtools"
        ],
        "modelDescription": "Run 0xTools' deterministic security analyzers (reentrancy, unchecked calls, access control, missing events, natspec, dangerous patterns, DeFi risks, MEV) over Solidity code. Pass `source` (code) or `path` (file/project). Returns findings with file, line, severity, message.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "description": "Solidity source code to audit"
            },
            "path": {
              "type": "string",
              "description": "Absolute path to a .sol file or project directory"
            }
          }
        }
      },
      {
        "name": "0xtools_scan_signatures",
        "displayName": "0xTools: Scan Signatures",
        "toolReferenceName": "scanSignatures",
        "canBeReferencedInPrompt": true,
        "icon": "$(symbol-method)",
        "tags": [
          "solidity",
          "selectors",
          "0xtools"
        ],
        "modelDescription": "Scan a Solidity project or file and return every contract's function/event/error signatures with exact 4-byte selectors and 32-byte topics.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to a .sol file or project directory"
            }
          },
          "required": [
            "path"
          ]
        }
      },
      {
        "name": "0xtools_compute_selector",
        "displayName": "0xTools: Compute Selector",
        "toolReferenceName": "computeSelector",
        "canBeReferencedInPrompt": true,
        "icon": "$(symbol-key)",
        "tags": [
          "solidity",
          "selectors",
          "0xtools"
        ],
        "modelDescription": "Compute the exact 4-byte selector and event topic0 for a canonical signature like transfer(address,uint256). Never guess selectors — call this.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "signature": {
              "type": "string",
              "description": "Canonical signature, e.g. transfer(address,uint256)"
            }
          },
          "required": [
            "signature"
          ]
        }
      },
      {
        "name": "0xtools_lookup_selector",
        "displayName": "0xTools: Lookup Selector",
        "toolReferenceName": "lookupSelector",
        "canBeReferencedInPrompt": true,
        "icon": "$(search)",
        "tags": [
          "solidity",
          "selectors",
          "0xtools"
        ],
        "modelDescription": "Resolve an unknown 4-byte selector (e.g. 0xa9059cbb) to known text signatures via the cached 4byte.directory.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "selector": {
              "type": "string",
              "description": "4-byte selector, e.g. 0xa9059cbb"
            }
          },
          "required": [
            "selector"
          ]
        }
      },
      {
        "name": "0xtools_decode_calldata",
        "displayName": "0xTools: Decode Calldata",
        "toolReferenceName": "decodeCalldata",
        "canBeReferencedInPrompt": true,
        "icon": "$(file-binary)",
        "tags": [
          "evm",
          "calldata",
          "0xtools"
        ],
        "modelDescription": "Decode raw EVM calldata into function name and typed argument values, using workspace signatures and the 4byte directory.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "calldata": {
              "type": "string",
              "description": "0x-prefixed calldata blob"
            }
          },
          "required": [
            "calldata"
          ]
        }
      },
      {
        "name": "0xtools_encode_calldata",
        "displayName": "0xTools: Encode Calldata",
        "toolReferenceName": "encodeCalldata",
        "canBeReferencedInPrompt": true,
        "icon": "$(file-code)",
        "tags": [
          "evm",
          "calldata",
          "0xtools"
        ],
        "modelDescription": "ABI-encode a function call from a human signature and comma-separated args. Returns selector + calldata hex.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "signature": {
              "type": "string",
              "description": "Function signature, e.g. transfer(address,uint256)"
            },
            "args": {
              "type": "string",
              "description": "Comma-separated argument values"
            }
          },
          "required": [
            "signature"
          ]
        }
      },
      {
        "name": "0xtools_keccak256",
        "displayName": "0xTools: Keccak-256",
        "toolReferenceName": "keccak256",
        "canBeReferencedInPrompt": true,
        "icon": "$(key)",
        "tags": [
          "evm",
          "hash",
          "0xtools"
        ],
        "modelDescription": "Keccak-256 hash of UTF-8 text (mode utf8) or a 0x hex byte string (mode hex). Deterministic — never guess hashes.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "utf8",
                "hex"
              ]
            }
          },
          "required": [
            "input"
          ]
        }
      },
      {
        "name": "0xtools_convert_eth_units",
        "displayName": "0xTools: Convert ETH Units",
        "toolReferenceName": "convertEthUnits",
        "canBeReferencedInPrompt": true,
        "icon": "$(arrow-swap)",
        "tags": [
          "evm",
          "units",
          "0xtools"
        ],
        "modelDescription": "Convert amounts between wei/gwei/ether and all named units. Input like '1.5 ether' or '21000 gwei'. Returns the full conversion table.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "description": "e.g. '1.5 ether' or a bare wei value"
            }
          },
          "required": [
            "amount"
          ]
        }
      }
    ],
    "configuration": {
      "title": "0xTools",
      "properties": {
        "sigscan.ai.enableTools": {
          "type": "boolean",
          "default": true,
          "description": "Expose 0xTools to AI agents (Copilot agent mode language-model tools). Every invocation is logged to the '0xTools AI' output channel and flashed in the status bar."
        },
        "sigscan.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan for signatures when files change"
        },
        "sigscan.scanInterval": {
          "type": "number",
          "default": 5,
          "description": "Scan interval in seconds"
        },
        "sigscan.outputFormats": {
          "type": "array",
          "default": [
            "txt",
            "json"
          ],
          "description": "Output formats to generate",
          "items": {
            "type": "string",
            "enum": [
              "txt",
              "json",
              "csv",
              "md"
            ]
          }
        },
        "sigscan.contractDirs": {
          "type": "array",
          "default": [
            "src",
            "contracts"
          ],
          "description": "Directories to scan for contracts"
        },
        "sigscan.excludeInternal": {
          "type": "boolean",
          "default": true,
          "description": "Exclude internal functions from output"
        },
        "sigscan.excludePrivate": {
          "type": "boolean",
          "default": true,
          "description": "Exclude private functions from output"
        },
        "sigscan.generateABI": {
          "type": "boolean",
          "default": true,
          "description": "Automatically generate ABI files alongside signatures"
        },
        "sigscan.estimateGas": {
          "type": "boolean",
          "default": true,
          "description": "Include gas estimation in reports"
        },
        "sigscan.checkSize": {
          "type": "boolean",
          "default": true,
          "description": "Check contract size against 24KB limit"
        },
        "sigscan.analyzeComplexity": {
          "type": "boolean",
          "default": false,
          "description": "Analyze code complexity metrics"
        },
        "sigscan.realtimeAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time gas analysis and inline annotations as you type"
        },
        "sigscan.realtime.solcIdleMs": {
          "type": "number",
          "default": 10000,
          "minimum": 0,
          "maximum": 60000,
          "description": "Run accurate solc gas estimation after this many milliseconds of no typing (0 = disabled, 10000 = 10 seconds recommended)"
        },
        "sigscan.gas.solcOnly": {
          "type": "boolean",
          "default": true,
          "description": "Use only solc compiler for gas estimates (no heuristic fallback). Recommended for accuracy."
        },
        "sigscan.etherscanApiKey": {
          "type": "string",
          "default": "",
          "description": "Etherscan API key for contract verification"
        },
        "sigscan.runnerBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the 0xtools-runner binary. Leave empty for auto-discovery (bundled, PATH, or workspace)."
        },
        "sigscan.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "description": "Log level for 0xTools output channel"
        },
        "sigscan.preferRunner": {
          "type": "boolean",
          "default": true,
          "description": "Use 0xtools-runner (EVM execution) as the primary gas backend when available. Disable to use forge/solc instead."
        },
        "sigscan.defaultChain": {
          "type": "string",
          "default": "ethereum",
          "enum": [
            "ethereum",
            "sepolia",
            "polygon",
            "arbitrum",
            "optimism",
            "bsc",
            "base",
            "avalanche"
          ],
          "description": "Default chain for on-chain operations (tx inspect, address lookup, events)"
        },
        "sigscan.rpc.customEndpoints": {
          "type": "object",
          "default": {},
          "description": "Custom RPC endpoints per chain. Example: { \"ethereum\": \"https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY\" }"
        },
        "sigscan.tenderly.accessKey": {
          "type": "string",
          "default": "",
          "description": "Tenderly API access key for transaction simulation"
        },
        "sigscan.tenderly.accountSlug": {
          "type": "string",
          "default": "",
          "description": "Tenderly account slug"
        },
        "sigscan.tenderly.projectSlug": {
          "type": "string",
          "default": "",
          "description": "Tenderly project slug"
        }
      }
    },
    "notebooks": [
      {
        "type": "sigscan-notebook",
        "displayName": "0xTools Notebook",
        "selector": [
          {
            "filenamePattern": "*.sigscan"
          }
        ]
      }
