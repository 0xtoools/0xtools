    "views": {
      "explorer": [
        {
          "id": "sigScanExplorer",
          "name": "Contract Signatures",
          "when": "sigscan:hasContracts"
        }
      ],
      "zeroXTools": [
        {
          "id": "zeroXTools.deployRun",
          "name": "Deploy & Run",
          "type": "webview"
        },
        {
          "id": "zeroXTools.findings",
          "name": "Findings",
          "icon": "$(warning)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zeroXTools.findings",
        "contents": "No findings yet.\nOpen a Solidity file and save it to run security & quality analysis (reentrancy, access control, MEV, and more).\n[Browse all 0xTools commands](command:sigscan.showAllCommands)\n[Scan project for signatures](command:sigscan.scanProject)\n[Open the Get Started walkthrough](command:workbench.action.openWalkthrough?%220xshubhs.0xtools%23zeroXTools.gettingStarted%22)"
      }
    ],
    "walkthroughs": [
      {
        "id": "zeroXTools.gettingStarted",
        "title": "Get Started with 0xTools",
        "description": "Selectors, real-time gas, security analysis, and a full deploy-and-run loop — all inside VS Code.",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome to 0xTools",
            "description": "The complete Solidity toolkit. Open a .sol file to see selectors, gas, and findings light up.\n[Browse all commands](command:sigscan.showAllCommands)",
            "media": {
              "markdown": "media/walkthrough/welcome.md"
            }
          },
          {
            "id": "scan",
            "title": "Scan for signatures",
            "description": "Extract every function selector, event topic, and error selector in your project.\n[Scan project](command:sigscan.scanProject)",
            "media": {
              "markdown": "media/walkthrough/scan.md"
            },
            "completionEvents": [
              "onCommand:sigscan.scanProject"
            ]
          },
          {
            "id": "gas",
            "title": "See real-time gas",
            "description": "Inline gas annotations appear as you type. Estimate the active contract on demand with Cmd/Ctrl+K G.\n[Estimate gas](command:sigscan.estimateGas)",
            "media": {
              "markdown": "media/walkthrough/gas.md"
            },
            "completionEvents": [
              "onCommand:sigscan.estimateGas"
            ]
          },
          {
            "id": "security",
            "title": "Find vulnerabilities",
            "description": "Reentrancy, access control, MEV, unchecked calls and more — surfaced in the Findings view with quick-fixes.\n[Open the Findings view](command:zeroXTools.findings.focus)",
            "media": {
              "markdown": "media/walkthrough/security.md"
            }
          },
          {
            "id": "deploy",
            "title": "Deploy & interact",
            "description": "Compile, deploy, call functions, and verify — without leaving the editor. Open the panel with Cmd/Ctrl+K D.\n[Open Deploy & Run](command:sigscan.deployRun.show)",
            "media": {
              "markdown": "media/walkthrough/deploy.md"
            },
            "completionEvents": [
              "onCommand:sigscan.deployRun.show"
            ]
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sigscan.refreshSignatures",
          "when": "view == sigScanExplorer",
          "group": "navigation",
          "icon": "$(refresh)"
        },
        {
          "command": "sigscan.deployRun.refresh",
          "when": "view == zeroXTools.deployRun",
          "group": "navigation",
          "icon": "$(refresh)"
        }
      ],
      "editor/context": [
        {
          "submenu": "0xtools.editor",
          "group": "z_commands",
          "when": "editorLangId == solidity"
        },
        {
          "command": "sigscan.decodeCalldata",
          "when": "editorHasSelection && editorLangId != solidity",
          "group": "0xtools@9"
        }
      ],
      "0xtools.editor": [
        {
          "command": "sigscan.scanProject",
          "group": "1_scan@1"
        },
        {
          "command": "sigscan.estimateGas",
          "group": "2_analyze@1"
        },
        {
          "command": "sigscan.checkContractSize",
          "group": "2_analyze@2"
        },
        {
          "command": "sigscan.showStorageLayout",
          "group": "2_analyze@3"
        },
        {
          "command": "sigscan.showCallGraph",
          "group": "2_analyze@4"
        },
        {
          "command": "sigscan.suggestOptimizations",
          "group": "2_analyze@5"
        },
        {
          "command": "sigscan.generateAllReports",
          "group": "2_analyze@6"
        },
        {
          "command": "sigscan.runSlither",
          "group": "3_security@1"
        },
        {
          "command": "sigscan.flattenContract",
          "group": "4_tools@1"
        },
        {
          "command": "sigscan.generateTests",
          "group": "4_tools@2"
        },
        {
          "command": "sigscan.decodeCalldata",
          "when": "editorHasSelection",
          "group": "9_evmtools@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sigscan.scanProject",
          "when": "sigscan:hasContracts"
        }
      ]
    },
    "submenus": [
      {
        "id": "0xtools.editor",
        "label": "0xTools"
      }
    ],
    "keybindings": [
      {
        "command": "sigscan.estimateGas",
        "key": "ctrl+k g",
        "mac": "cmd+k g",
        "when": "editorTextFocus && editorLangId == solidity"
      },
      {
        "command": "sigscan.showStorageLayout",
        "key": "ctrl+k l",
        "mac": "cmd+k l",
        "when": "editorTextFocus && editorLangId == solidity"
      },
      {
        "command": "sigscan.deployRun.show",
        "key": "ctrl+k d",
        "mac": "cmd+k d",
        "when": "editorLangId == solidity"
      },
      {
        "command": "sigscan.generateAllReports",
        "key": "ctrl+k r",
        "mac": "cmd+k r",
        "when": "editorTextFocus && editorLangId == solidity"
      },
      {
        "command": "sigscan.showAllCommands",
        "key": "ctrl+k 0",
        "mac": "cmd+k 0"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "postinstall": "node scripts/postinstall.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cli": "node dist/cli/index.js",
    "build": "webpack --mode production",
    "package": "node scripts/package-vsix.js",
    "package:no-install": "node scripts/package-vsix.js --no-install",
    "dev": "webpack --mode development",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "prepare": "husky"
  },
  "lint-staged": {
    "!(website)/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
